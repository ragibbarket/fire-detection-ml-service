BACKEND_URL=http://localhost:5000
RETRAIN_INTERVAL_MINUTES=30

# ---- Explanation thresholds (wording of the "reasoning" text only) ----
SMOKE_HIGH_THRESHOLD=450
SMOKE_ELEVATED_THRESHOLD=300
TEMP_HIGH_THRESHOLD=45
TEMP_ELEVATED_THRESHOLD=32
HUMIDITY_LOW_THRESHOLD=40

# ---- Training data ranges (change the model: retrain after editing) ----
# "fire" class: flame-on probability and uniform ranges
TRAIN_FIRE_FLAME_PROB=0.85
TRAIN_FIRE_SMOKE_MIN=380
TRAIN_FIRE_SMOKE_MAX=800
TRAIN_FIRE_TEMP_MIN=40
TRAIN_FIRE_TEMP_MAX=70
TRAIN_FIRE_HUMIDITY_MIN=15
TRAIN_FIRE_HUMIDITY_MAX=45
# "false_alarm" class
TRAIN_FALSE_FLAME_PROB=0.10
TRAIN_FALSE_SMOKE_MIN=280
TRAIN_FALSE_SMOKE_MAX=560
TRAIN_FALSE_TEMP_MIN=30
TRAIN_FALSE_TEMP_MAX=50
TRAIN_FALSE_HUMIDITY_MIN=30
TRAIN_FALSE_HUMIDITY_MAX=65
